# =============================================================================
# CalorIA — Variáveis de Ambiente (DESENVOLVIMENTO)
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de Dados
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://caloria:caloria@postgres:5432/caloria_db
# Para desenvolvimento local sem Docker:
# DATABASE_URL=postgresql+asyncpg://caloria:caloria@localhost:5432/caloria_db

POSTGRES_USER=caloria
POSTGRES_PASSWORD=caloria
POSTGRES_DB=caloria_db

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
# Para desenvolvimento local sem Docker:
# REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Segurança JWT
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------------
SECRET_KEY=sua-chave-secreta-aqui-minimo-32-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# -----------------------------------------------------------------------------
# IA — Groq (texto e visão, free tier generoso)
# Obtenha em: https://console.groq.com/keys
# -----------------------------------------------------------------------------
GROQ_API_KEY=sua-chave-groq-aqui

# Parâmetros de amostragem — explícitos para o eval ser reprodutível.
# GROQ_SEED=-1 significa "não enviar o parâmetro".
GROQ_TEMPERATURE=0.1
GROQ_TEMPERATURE_SEM_SYSTEM=0.3
GROQ_MAX_TOKENS=8192
GROQ_SEED=-1
GROQ_TIMEOUT_SECONDS=60
GROQ_SDK_MAX_RETRIES=2
# Teto de tempo TOTAL no backoff próprio por rate limit.
GROQ_RETRY_MAX_SECONDS=120

# -----------------------------------------------------------------------------
# Rate limiting — expressões no formato "N/period" da lib `limits`
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_FORGOT_PASSWORD=5/minute
# POST de IA (analyze-meal, analyze-photo, insights)
RATE_LIMIT_AI=20/minute
# GET de IA que consultam o provedor (patterns, alerts, relatório mensal…)
RATE_LIMIT_AI_LEITURA=40/minute
# Vazio = contagem em memória do processo. Com mais de um worker, usar Redis
# com o prefixo `async+` que o `limits` exige em contexto assíncrono:
# RATE_LIMIT_STORAGE_URI=async+redis://redis:6379/1
RATE_LIMIT_STORAGE_URI=
# Ligar SOMENTE com proxy reverso confiável à frente (Caddy em produção). Sem
# proxy, X-Forwarded-For é forjável e vira caminho trivial de burlar o limite.
RATE_LIMIT_TRUST_FORWARDED_FOR=false

# Teto de itens em POST /api/v1/reminders/batch
REMINDERS_BATCH_MAX_ITEMS=50

# -----------------------------------------------------------------------------
# Web Push (VAPID) — necessário para notificações
# Gere com: python scripts/gen_vapid.py
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=sua-chave-publica-vapid
VAPID_PRIVATE_KEY=sua-chave-privada-vapid
VAPID_CLAIMS_EMAIL=seu@email.com

# -----------------------------------------------------------------------------
# Frontend — Next.js / next-auth
# Gere com: openssl rand -base64 32
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=sua-chave-nextauth-aqui
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# E-mail transacional (SMTP) — recuperação de senha
# Sem SMTP_HOST, o link de reset é apenas logado (dev), sem falhar.
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CalorIA <no-reply@caloria.app>
FRONTEND_URL=http://localhost:3000
RESET_TOKEN_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------------
# USDA FoodData Central (importador de alimentos — opcional)
# Chave gratuita em: https://fdc.nal.usda.gov/api-guide.html
# -----------------------------------------------------------------------------
USDA_API_KEY=sua-chave-usda-aqui

# -----------------------------------------------------------------------------
# Configurações opcionais
# -----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
