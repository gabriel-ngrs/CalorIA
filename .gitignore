# =============================================================================
# CalorIA — .gitignore
# =============================================================================

# ---------------------------------------------------------------------------
# Variáveis de ambiente e segredos — NUNCA commitar
# ---------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg

# Ambientes virtuais
.venv/
venv/
env/
ENV/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# ruff
.ruff_cache/

# Celery
celerybeat-schedule
celerybeat-schedule.*
celerybeat.pid

# pytest
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# ---------------------------------------------------------------------------
# Node.js / Next.js / Frontend
# ---------------------------------------------------------------------------
node_modules/
.next/
.next-dev/
out/
build/
dist/

# Cache
.npm
.eslintcache
.parcel-cache

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel
.vercel/

# Playwright
test-results/
playwright-report/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------
# Volumes locais (ignorar dados persistidos localmente)
postgres_data/
redis_data/
evolution_data/

# ---------------------------------------------------------------------------
# Alembic
# ---------------------------------------------------------------------------
# Não ignorar: alembic/versions/*.py são migrações commitadas

# ---------------------------------------------------------------------------
# IDE e editores
# ---------------------------------------------------------------------------
.idea/
.vscode/
.claude/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Ferramentas de automação / auditoria
# ---------------------------------------------------------------------------
.playwright-mcp/
.prints/

# ---------------------------------------------------------------------------
# Logs e temporários
# ---------------------------------------------------------------------------
*.log
logs/
tmp/
temp/
vapid_private.pem

# ---------------------------------------------------------------------------
# Dados — arquivos grandes não versionados
# ---------------------------------------------------------------------------
# Os dois abaixo são publicados como asset da release (ver data/README.md)
data/db/*.dump
data/processed/alimentos_final.csv
data/raw/*.gz
data/raw/*.zip
data/raw/*.jsonl
.codeflow/checkpoints/

# ---------------------------------------------------------------------------
# Telemetria de execução do codeflow — fica em disco, não no versionamento
# ---------------------------------------------------------------------------
.codeflow/specs/*/artefatos/
.codeflow/bug-batches/artefatos/
.codeflow/bug-batches/*.origin.txt
docs/auditoria/artefatos/

# Artefatos de instrumentação gerados dentro do container (bind mount backend/ -> /app)
backend/artefatos/
# Build de sondagem criado durante QA
frontend/.next-probe/

# Artefatos de uma execução do eval (o histórico versionado é o history.jsonl)
backend/evals/runs/ultimo-relatorio.json
backend/evals/runs/ultima-invariancia.json
